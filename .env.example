# Base de datos SQLite local (ubicada en prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Clave secreta para firma HMAC-SHA256 de sesiones HTTP-only (cambiar en producción)
SESSION_SECRET="replace-with-strong-hmac-sha256-session-secret-key"

# Zona horaria institucional de referencia
APP_TIMEZONE="America/Monterrey"

# Indicador de entorno de demostración (muestra advertencia de seguridad de credenciales demo)
DEMO_MODE="true"

# Ruta de almacenamiento privado de evidencias PDF (fuera de /public)
STORAGE_DIR="./storage/evidences"

# Ruta de almacenamiento privado de imágenes PNG de códigos QR individuales (fuera de /public)
QR_STORAGE_DIR="./storage/qrs"

# Límite máximo de tamaño para carga de archivos PDF de evidencia (en MB)
MAX_PDF_SIZE_MB="15"

# Dominio sugerido para validación de correo institucional (opcional)
INSTITUTIONAL_EMAIL_DOMAIN="utc.edu.mx"

# Configuración opcional de servidor SMTP para envío de pases e invitaciones QR
# Si no se configura, el sistema opera normalmente registrando el envío como PENDING y permitiendo descarga directa del QR/PDF
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="SREU Universidad <notificaciones@utc.edu.mx>"
MAIL_SECURE="false"

# Variable requerida únicamente para ejecutar npm run db:reset-demo
# CONFIRM_DEMO_RESET="true"

# Contraseñas iniciales para el seed de base de datos en instalaciones nuevas (definir en .env antes de ejecutar npm run setup)
SEED_DEFAULT_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_DIRECTOR1_PASSWORD=""
SEED_DIRECTOR2_PASSWORD=""
SEED_DIRECTOR3_PASSWORD=""
SEED_DIRECTOR4_PASSWORD=""
SEED_EXTENSION_PASSWORD=""
